# =============================================
# DATABASE (Neon PostgreSQL recomendado)
# =============================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Opcional (Neon): URL direta (sem -pooler), só para `prisma migrate deploy`. O schema NÃO lê esta
# variável; para usar, rode as migrations com DATABASE_URL apontando para ela.
# DIRECT_URL="postgresql://user:password@host/flerte_ia?sslmode=require"

# =============================================
# NEXTAUTH
# =============================================
NEXTAUTH_URL="https://flertia.com.br"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# =============================================
# GOOGLE OAUTH (opcional)
# =============================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================
# OPENAI
# =============================================
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# =============================================
# ABACATE PAY
# =============================================
ABACATEPAY_API_KEY="abc_dev_your-abacatepay-api-key"
ABACATEPAY_BASE_URL="https://api.abacatepay.com/v2"
# IDs dos produtos no painel — o webhook deduz o plano pelo produto pago
ABACATEPAY_PRODUCT_ID_MONTHLY="prod_monthly-id"
ABACATEPAY_PRODUCT_ID_ANNUAL="prod_annual-id"
ABACATEPAY_PRODUCT_ID_LIFETIME="prod_lifetime-id"
# OBRIGATÓRIO. Mesmo valor definido ao criar o webhook no painel (gere com: openssl rand -hex 32).
# URL do webhook: https://SEU_DOMINIO/api/webhooks/abacatepay
ABACATEPAY_WEBHOOK_SECRET="your-webhook-secret-min-32-chars"
# RECOMENDADO. Chave pública HMAC da AbacatePay (copie de https://docs.abacatepay.com/pages/webhooks/security.md).
# Quando definida, toda requisição precisa do header X-Webhook-Signature válido.
ABACATEPAY_PUBLIC_KEY=""

# =============================================
# EMAIL (SMTP)
# =============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Flert IA <noreply@flertia.com.br>"

# =============================================
# APP
# =============================================
NEXT_PUBLIC_APP_URL="https://flertia.com.br"
# OBRIGATÓRIO para o painel /admin. E-mail exato da conta administradora.
# Sem esta variável ninguém é admin (falha fechada). Reservado: não pode ser cadastrado por senha.
ADMIN_EMAIL="admin@seu-dominio.com"

# Só fora da Vercel: header com o IP real do cliente definido pelo SEU proxy
# (ex.: "cf-connecting-ip" no Cloudflare, "x-real-ip" no nginx). Na Vercel, deixe vazio.
# Sem ele (fora da Vercel), todos os clientes compartilham o mesmo limite por IP.
TRUSTED_IP_HEADER=""
